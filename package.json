{
  "name": "larax",
  "license": "MIT",
  "version": "0.2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "release": "pnpm run build && changeset publish"
  },
  "packageManager": "pnpm@11.21.0",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "laravel",
    "larax",
    "laravel-like",
    "helpers",
    "utilities",
    "javascript",
    "nodejs",
    "typescript",
    "str",
    "arr",
    "collection"
  ],
  "description": "Larax is an NPM package that provides Laravel-inspired helpers written in JavaScript, making it easy to use Laravel-style utilities in your Node.js or frontend projects.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abbas-roholamin/larax.git"
  },
  "bugs": {
    "url": "https://github.com/abbas-roholamin/larax/issues"
  },
  "homepage": "https://github.com/abbas-roholamin/larax#readme",
  "author": {
    "name": "Abbas Roholamin",
    "email": "abbasroholamin76@gmail.com",
    "url": "https://github.com/abbas-roholamin"
  }
}
